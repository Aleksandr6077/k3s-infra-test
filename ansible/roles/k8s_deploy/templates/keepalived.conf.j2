vrrp_script check_haproxy {
    script "/usr/bin/killall -0 haproxy"
    interval 2
    weight 2
}

vrrp_instance VI_1 {
    state BACKUP # Обе ноды стартуют как BACKUP, выбор MASTER пройдет по приоритету автоматически
    interface eth0
    virtual_router_id 51
    priority 100 
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ vault_keepalived_pass }}
    }

    virtual_ipaddress {
        172.20.0.10
    }

    track_script {
        check_haproxy
    }
}





